-- ============ EXEC PATH ============
local function getExecPath()
    local ok, path = pcall(function()
        if getworkspace then return getworkspace() .. "/A_HUB_Ultimate" end
    end)
    if ok and path then
        pcall(function() makefolder(path) end)
        return path
    end
    return "A_HUB_Ultimate"
end

local DUMP_DIR = getExecPath()
pcall(function() makefolder(DUMP_DIR) end)

local function safeWrite(filename, content)
    local fullPath = DUMP_DIR .. "/" .. filename
    local ok = pcall(function()
        if writefile then writefile(fullPath, content) end
    end)
    return ok, fullPath
end

local function safeAppend(filename, content)
    local fullPath = DUMP_DIR .. "/" .. filename
    local ok = pcall(function()
        if appendfile then appendfile(fullPath, content) end
    end)
    return ok
end

