        infoLog("PlaceId: " .. game.PlaceId, COLORS.info)
        infoLog("GameId: " .. game.GameId, COLORS.info)
        infoLog("JobId: " .. game.JobId, COLORS.info)
        infoLog("Creator: " .. tostring(game.CreatorId) .. " (" .. tostring(game.CreatorType) .. ")", COLORS.info)
        infoLog("Player: " .. LocalPlayer.Name .. " (" .. LocalPlayer.UserId .. ")", COLORS.info)
        infoLog("AccountAge: " .. LocalPlayer.AccountAge .. " days", COLORS.info)
        infoLog("Executor:", COLORS.warn)
        for _, name in ipairs({"syn","krnl","fluxus","delta","wave","hydrogen","scriptware","swift","arceus","codex","electron","trigon","sirhurt"}) do
            if identifyexecutor and string.find(string.lower(identifyexecutor()), name) then
