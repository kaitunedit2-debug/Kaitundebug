    local function dumpTree(root, filename, includeProps)
        local lines = {}
        local count = 0
        local function walk(obj, depth)
            if count > 50000 then return end
            count = count + 1
            local indent = string.rep("  ", depth)
            local line = indent .. obj.ClassName .. " \"" .. obj.Name .. "\""
            if includeProps then
                local ok, props = pcall(function()
                    local p = {}
                    for _, prop in ipairs({"Value","Text","PlaceId","UserId","Health","WalkSpeed","JumpPower","Anchored","CanCollide","Transparency"}) do
                        local ok2, val = pcall(function() return obj[prop] end)
                        if ok2 and val ~= nil then
                            if typeof(val) == "string" or typeof(val) == "number" or typeof(val) == "boolean" then
                                p[#p+1] = prop.."="..tostring(val)
                            end
                        end
                    end
                    return p
                end)
                if ok and props and #props > 0 then
                    line = line .. " [" .. table.concat(props, ", ") .. "]"
                end
            end
            lines[#lines+1] = line
            for _, child in ipairs(obj:GetChildren()) do
                walk(child, depth + 1)
            end
        end
        walk(root, 0)
        local content = table.concat(lines, "\n")
        local ok, path = safeWrite(filename, content)
        return ok, #lines, path
    end

