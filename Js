                if ok and src and #src > 0 then sourceAvail = sourceAvail + 1 end
            end
        end
        vulnLog("ℹ Source available: " .. sourceAvail .. "/" .. totalScripts .. " scripts", COLORS.info)
        
        -- 7. Check Net module (sleitnick)
        local netModule = ReplicatedStorage:FindFirstChild("Net", true) or (ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Net"))
        if netModule then
            vulnLog("ℹ Net module found: " .. netModule:GetFullName(), COLORS.info)
        end
        
        -- Save findings
        if #findings > 0 then
            local lines = {"=== VULN FINDINGS ==="}
            for _, f in ipairs(findings) do
                if f.type == "suspicious-remote" then
                    lines[#lines+1] = "[REMOTE] " .. f.path .. " (match: " .. f.match .. ")"
                elseif f.type == "dangerous-script" then
                    lines[#lines+1] = "[SCRIPT] " .. f.path .. " (pattern: " .. f.pattern .. ")"
                end
            end
            safeWrite("vuln_findings.txt", table.concat(lines, "\n"))
        end
        
        vulnLog("═══ SCAN COMPLETE — " .. #findings .. " findings ═══", COLORS.success)
    end)

