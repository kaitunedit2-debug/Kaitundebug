    end)

    -- ============ TAB: SPY ============
    local SpyPage = MakeTab("SPY", 3)
    local spyLog, spyClear, spyGet = makeLogBox(SpyPage)
    spyClear()

    local spying = false
    local spyConnections = {}
    local spyHook = nil
    local loggedOutgoing = {}

    local function stopSpy()
        spying = false
        for _, c in ipairs(spyConnections) do
            pcall(function() c:Disconnect() end)
        end
        spyConnections = {}
        if spyHook then
            pcall(function() spyHook() end)
            spyHook = nil
        end
    end

    local spyBtn = makeButton(SpyPage, "▶ START SPY", UDim2.new(0, 5, 0, 5), UDim2.new(0, 120, 0, 30), function()
        if spying then
            stopSpy()
            spyBtn.Text = "▶ START SPY"
            spyBtn.BackgroundColor3 = COLORS.btn
            spyLog("[A HUB] Spy stopped", COLORS.warn)
            return
        end
        spying = true
        spyBtn.Text = "■ STOP SPY"
        spyBtn.BackgroundColor3 = COLORS.danger
        spyLog("[A HUB] Spy started", COLORS.success)

        -- Hook ALL remotes' OnClientEvent
        for _, obj in ipairs(game:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent") then
                pcall(function()
                    local conn = obj.OnClientEvent:Connect(function(...)
                        if not spying then return end
                        local args = {...}
                        local argStrs = {}
                        for i = 1, math.min(#args, 6) do
                            local v = args[i]
                            local str
                            if typeof(v) == "table" then
                                local ok, json = pcall(function() return HttpService:JSONEncode(v) end)
                                str = ok and json or tostring(v)
                            else
                                str = tostring(v)
                            end
                            if #str > 80 then str = str:sub(1, 80) .. "..." end
                            argStrs[i] = str
                        end
                        spyLog("[IN] " .. obj.Name .. "(" .. table.concat(argStrs, ", ") .. ")", COLORS.success)
                    end)
                    spyConnections[#spyConnections+1] = conn
                end)
            end
        end
        spyLog("Hooked OnClientEvent of " .. #spyConnections .. " remotes", COLORS.info)

        -- Watch for new remotes        local descConn = game.DescendantAdded:Connect(function(obj)
            if not spying then return end
            if obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent") then
                pcall(function()
                    local conn = obj.OnClientEvent:Connect(function(...)
                        if not spying then return end
                        local args = {...}
                        local argStrs = {}
                        for i = 1, math.min(#args, 6) do
                            argStrs[i] = tostring(args[i]):sub(1, 80)
                        end
                        spyLog("[IN+] " .. obj.Name .. "(" .. table.concat(argStrs, ", ") .. ")", COLORS.success)
                    end)
                    spyConnections[#spyConnections+1] = conn
                end)
                spyLog("[REMOTE+] New: " .. obj:GetFullName(), COLORS.warn)
            end
        end)
        spyConnections[#spyConnections+1] = descConn

        -- Watch players
        local playerConn = Players.PlayerAdded:Connect(function(p)
            if spying then spyLog("[PLAYER+] " .. p.Name, COLORS.success) end
        end)
        spyConnections[#spyConnections+1] = playerConn

        -- Watch workspace spawns
        local wsConn = Workspace.DescendantAdded:Connect(function(obj)
            if not spying then return end
            if obj:IsA("Model") or obj:IsA("Part") then
                local parentName = obj.Parent and obj.Parent.Name or "?"
                spyLog("[SPAWN] " .. obj.ClassName .. " '" .. obj.Name .. "' in " .. parentName, COLORS.info)
            end
        end)
        spyConnections[#spyConnections+1] = wsConn

        -- Try to hook outgoing FireServer via hookmetamethod
        if hookmetamethod and getnamecallmethod and not spyHook then
            local originalNamecall
            originalNamecall = hookmetamethod(game, "__namecall", function(self, ...)
                local method = getnamecallmethod()
                if spying and (method == "FireServer" or method == "InvokeServer") then
                    if self:IsA("RemoteEvent") or self:IsA("RemoteFunction") then
                        local args = {...}
                        local argStrs = {}
                        for i = 1, math.min(#args, 6) do
                            local v = args[i]
                            local str
                            if typeof(v) == "table" then
                                local ok, json = pcall(function() return HttpService:JSONEncode(v) end)
                                str = ok and json or tostring(v)
                            else
                                str = tostring(v)
                            end
                            if #str > 80 then str = str:sub(1, 80) .. "..." end
                            argStrs[i] = str
                        end
                        spyLog("[OUT] " .. self.Name .. "(" .. table.concat(argStrs, ", ") .. ")", COLORS.warn)
                        loggedOutgoing[#loggedOutgoing+1] = {name = self.Name, args = args}
                    end
                end
                return originalNamecall(self, ...)
            end)
            spyHook = function()
                pcall(function() hookmetamethod(game, "__namecall", originalNamecall) end)
            end
            spyLog("Outgoing hook active (hookmetamethod)", COLORS.success)
        else
            spyLog("Outgoing hook NOT available — incoming only", COLORS.warn)
        end
    end)

    makeButton(SpyPage, "Copy Spy Log", UDim2.new(0, 130, 0, 5), UDim2.new(0, 120, 0, 30), function()
        local content = spyGet()
        local ok = pcall(function()
            if setclipboard then setclipboard(content)
            elseif toclipboard then toclipboard(content) end
        end)
        spyLog(ok and "✔ Copied spy log" or "✘ Clipboard unavailable", ok and COLORS.success or COLORS.danger)
    end)

    makeButton(SpyPage, "Clear", UDim2.new(0, 255, 0, 5), UDim2.new(0, 80, 0, 30), function()
        spyClear()
        spyLog("[A HUB] Cleared", COLORS.success)
    end)

    makeButton(SpyPage, "Save Spy Log", UDim2.new(0, 340, 0, 5), UDim2.new(0, 120, 0, 30), function()
        local content = spyGet()
        local ok = safeWrite("spy_log_" .. os.time() .. ".txt", content)
        spyLog(ok and "✔ Saved to file" or "✘ Save failed", ok and COLORS.success or COLORS.danger)
    end)

    -- ============ TAB: PROBE ============
    local ProbePage = MakeTab("PROBE", 4)
    local probeLog, probeClear, probeGet = makeLogBox(ProbePage)
    probeClear()

    makeButton(ProbePage, "Test Net Module", UDim2.new(0, 5, 0, 5), UDim2.new(0, 150, 0, 28), function()
        probeClear()
        probeLog("→ Testing Net module...", COLORS.warn)
        local netModules = {}
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("ModuleScript") and obj.Name == "net" then
                netModules[#netModules+1] = obj
            end
        end
        if #netModules == 0 then
            probeLog("✘ Net module not found in ReplicatedStorage", COLORS.danger)
            return
        end
        for _, mod in ipairs(netModules) do
            probeLog("✔ Found: " .. mod:GetFullName(), COLORS.success)
            local ok, net = pcall(function() return require(mod) end)
            if ok then
                probeLog("✔ Loaded module", COLORS.success)
                probeLog("  Type: " .. typeof(net), COLORS.info)
                -- Enumerate remotes via Net
                local ok2, remotes = pcall(function() return net.remotes end)
                if ok2 and remotes then
                    local count = 0
                    for name, remote in pairs(remotes) do
                        probeLog("  [" .. typeof(remote) .. "] " .. name, COLORS.info)
                        count = count + 1
                    end
                    probeLog("  Total: " .. count, COLORS.success)
                end
            else
                probeLog("✘ Failed to load: " .. tostring(net), COLORS.danger)
            end
        end
    end)

    makeButton(ProbePage, "Dump All Net Remotes", UDim2.new(0, 160, 0, 5), UDim2.new(0, 150, 0, 28), function()
        probeLog("→ Dumping all Net remotes...", COLORS.warn)
        local netMod
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("ModuleScript") and obj.Name == "net" then
                netMod = obj
                break
            end
        end
        if not netMod then
            probeLog("✘ Net module not found", COLORS.danger)
            return
        end
        local ok, net = pcall(function() return require(netMod) end)
        if not ok then
            probeLog("✘ Cannot require Net", COLORS.danger)
            return
        end
        local lines = {"=== NET REMOTES ==="}
        local ok2, remotes = pcall(function() return net.remotes end)
        if ok2 and remotes then
            for name, remote in pairs(remotes) do
                local line = "[" .. typeof(remote) .. "] " .. name .. " | " .. tostring(remote)
                probeLog(line, COLORS.info)
                lines[#lines+1] = line
            end
        else
            probeLog("✘ Cannot access net.remotes", COLORS.danger)
        end
        local okSave = safeWrite("net_remotes.txt", table.concat(lines, "\n"))
        probeLog((okSave and "✔ " or "✘ ") .. "net_remotes.txt", okSave and COLORS.success or COLORS.danger)
    end)

    makeButton(ProbePage, "Fuzz All Remotes (careful)", UDim2.new(0, 315, 0, 5), UDim2.new(0, 180, 0, 28), function()
        probeLog("→ Fuzzing all remotes with no args...", COLORS.warn)
        probeLog("  (This will fire every remote — may cause kicks)", COLORS.danger)
        task.wait(1)
        local count = 0
        local success = 0
        for _, obj in ipairs(game:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                pcall(function()
                    obj:FireServer()
                    success = success + 1
                end)
                count = count + 1
                if count >= 50 then break end
            elseif obj:IsA("RemoteFunction") then
                pcall(function()
                    obj:InvokeServer()
                    success = success + 1
                end)
                count = count + 1
                if count >= 50 then break end
            end
        end
        probeLog("Fuzzed " .. count .. " remotes, " .. success .. " ok", COLORS.info)
    end)

    makeButton(ProbePage, "Copy Probe Log", UDim2.new(0, 5, 0, 38), UDim2.new(0, 150, 0, 28), function()
        local content = probeGet()
        local ok = pcall(function()
            if setclipboard then setclipboard(content)
            elseif toclipboard then toclipboard(content) end
        end)
        probeLog(ok and "✔ Copied" or "✘ Clipboard unavailable", ok and COLORS.success or COLORS.danger)
    end)

    -- ============ TAB: INFO ============
    local InfoPage = MakeTab("INFO", 5)
    local infoLog, infoClear, infoGet = makeLogBox(InfoPage)
    infoClear()

    makeButton(InfoPage, "Show Game Info", UDim2.new(0, 5, 0, 5), UDim2.new(0, 150, 0, 28), function()
        infoClear()
