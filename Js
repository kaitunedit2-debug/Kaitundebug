            end
        end
        if identifyexecutor then infoLog("  " .. identifyexecutor(), COLORS.success) end
        infoLog("Filesize dump dir: " .. DUMP_DIR, COLORS.info)
        infoLog("Timestamp: " .. os.date("%Y-%m-%d %H:%M:%S"), COLORS.info)
    end)

    makeButton(InfoPage, "Clear", UDim2.new(0, 160, 0, 5), UDim2.new(0, 100, 0, 28), function()
